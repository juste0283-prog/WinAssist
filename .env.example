# ============================================================
#  WinAssist — variables d'environnement (exemple)
#  Copie ce fichier vers `.env` puis remplis tes valeurs.
#  Le fichier `.env` est IGNORÉ par git (voir .gitignore) :
#  on ne commit JAMAIS de clé API.
# ============================================================

# --- Moteur de décision ----------------------------------------
# mock   : règles locales, aucun réseau (défaut, pour la démo)
# openai : LLM réel (function calling)
WINASSIST_LLM_MODE=mock

# --- Clés / serveur OpenAI-compatible ---------------------------
# API officielle OpenAI :
WINASSIST_API_KEY=
WINASSIST_API_BASE_URL=https://api.openai.com/v1
WINASSIST_MODEL=gpt-4o-mini

# OU un serveur local (Ollama) — laisser WINASSIST_API_KEY vide :
# WINASSIST_API_BASE_URL=http://localhost:11434/v1
# WINASSIST_MODEL=llama3.2

# --- Boucle agentique -------------------------------------------
WINASSIST_MAX_ITERATIONS=12
WINASSIST_STAGNATION_LIMIT=3

# --- Perception ------------------------------------------------
WINASSIST_ELEMENT_LIMIT=80
# Repli vision (point 3) : 1 = si UIA ne voit aucun élément interactif
# nommé, on analyse une capture d'écran avec un modèle multimodal.
WINASSIST_VISION_FALLBACK=1
# Si l'écran UIA contient moins d'éléments interactifs nommés que ce
# seuil, on bascule sur la vision.
WINASSIST_VISION_MIN_ELEMENTS=1
# Modèle utilisé pour la vision (doit être multimodal). Vide = modèle de décision.
WINASSIST_VISION_MODEL=
# Taille d'image max côté vision (octets, limite de coût).
WINASSIST_VISION_MAX_BYTES=1500000

# --- Sécurité ---------------------------------------------------
# 1 = activer le failsafe (souris dans un coin d'écran = arrêt)
WINASSIST_FAILSAFE=1
# 1 = confirmer à voix haute AVANT toute action sensible
# (vider la corbeille, éteindre/redémarrer le PC, supprimer...)
WINASSIST_CONFIRM_SENSITIVE=1

# --- Journal de session (point 5) --------------------------------
# 1 = écrire le journal JSON Lines de la session (réécoutable :
# « lit le journal » en vocal, ou commande "journal" en console)
WINASSIST_JOURNAL=1
WINASSIST_JOURNAL_DIR=logs

# --- Voix (TTS) -------------------------------------------------
WINASSIST_TTS=1
# pyttsx3 (local) ou edge (voix Microsoft, réseau)
WINASSIST_TTS_ENGINE=pyttsx3
WINASSIST_EDGE_VOICE=fr-FR-EloiseNeural

# --- Reconnaissance vocale (STT) --------------------------------
# auto | whisper_api | whisper_local | vosk | none
WINASSIST_STT_ENGINE=auto
# Taille du modèle Whisper local (tiny/base/small/medium)
WINASSIST_STT_MODEL_SIZE=base
WINASSIST_STT_LANGUAGE=fr
# Chemin du modèle Vosk (après scripts/download_models.py --vosk)
WINASSIST_VOSK_MODEL_PATH=

# --- Audio / VAD ------------------------------------------------
WINASSIST_AUDIO_SAMPLE_RATE=16000
WINASSIST_VAD_THRESHOLD=300
WINASSIST_MAX_PHRASE_SECONDS=10

# --- Mot d'activation -------------------------------------------
WINASSIST_WAKE_WORD=1
# Variantes « assistant » : comprises par le modèle Vosk français
# (« winassist » est un terme inventé, hors-vocabulaire de Vosk-FR).
WINASSIST_WAKE_PHRASES=ok winassist,hey winassist,bonjour winassist,winassist,ok assistant,assistant,dis assistant